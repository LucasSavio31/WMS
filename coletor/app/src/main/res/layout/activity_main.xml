<?xml version="1.0" encoding="utf-8"?>
<!-- Menu principal do coletor -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Endereço do servidor (PC):" />
    <EditText android:id="@+id/edServidor"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="textUri" android:hint="http://192.168.0.10:8000" />
    <Button android:id="@+id/btTestar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Salvar e testar conexão" />
    <TextView android:id="@+id/txStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingBottom="16dp" android:text="" />

    <Button android:id="@+id/btEntrada" android:layout_width="match_parent"
        android:layout_height="64dp" android:text="ENTRADA" />
    <Button android:id="@+id/btBaixa" android:layout_width="match_parent"
        android:layout_height="64dp" android:text="BAIXA" />
    <Button android:id="@+id/btInventario" android:layout_width="match_parent"
        android:layout_height="64dp" android:text="INVENTÁRIO" />
    <Button android:id="@+id/btConsulta" android:layout_width="match_parent"
        android:layout_height="64dp" android:text="CONSULTA" />
</LinearLayout>
